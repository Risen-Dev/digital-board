# Postgres connection string. Required.
DATABASE_URL=postgres://board:password@localhost:5432/board


# Pool size. Default 10.
# DATABASE_POOL_MAX=10

# Next.js listens on 3000 by default.
# PORT=3000

# Timezone used to render timestamps — they are formatted server-side.
# TZ=Asia/Jakarta
# REGISTRATION_CLOSED=1   # stop strangers registering workspaces on a public instance

# Emailed password-reset links. Off unless both SMTP_URL and APP_URL are set;
# without them an admin resets passwords from Settings.
# SMTP_URL=smtps://user:pass@smtp.example.com
# APP_URL=https://board.example.com
# MAIL_FROM=Digital Board <board@example.com>

# Encrypts the AI agent's API key and the GitHub token + webhook secret in the
# database. Unset = plain text. Changing it means re-entering them in Settings.
# openssl rand -hex 32
# SECRET_KEY=

# Outgoing webhooks and the AI base URL refuse loopback/LAN/metadata addresses.
# Set to 1 to allow them, e.g. for a local Ollama or n8n.
# ALLOW_PRIVATE_URLS=1
